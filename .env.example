# MongoDB Atlas Connection
# Replace with your MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/menucard_saas?retryWrites=true&w=majority
MONGODB_DB_NAME=menucard_saas

# Session & Security
# Generate a strong 32+ character random string for production
JWT_SECRET=your-super-secret-jwt-signing-key-change-in-production

# Google Identity Services
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Super Admin Bootstrapping
# Strictly server-side: Users with this email automatically get super_admin privileges
SUPER_ADMIN_EMAIL=admin@yourdomain.com

# Local Dev Server Port
PORT=3000
